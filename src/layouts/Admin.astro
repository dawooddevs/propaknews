---
import { getSetting } from '../lib/db';
interface Props { title: string; active?: string; subtitle?: string; wide?: boolean; }
const { title, active = '', subtitle = '', wide = false } = Astro.props;
const brand = getSetting('branding', {});
const seo = getSetting('seo', {});

// Lucide-style 24px stroke icons, inlined so the admin has no icon dependency.
const I: Record<string, string> = {
  dashboard: '<rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>',
  posts: '<path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8M15 18h-5M10 6h8v4h-8z"/>',
  pages: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4M10 9H8M16 13H8M16 17H8"/>',
  media: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/>',
  homepage: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1Z"/>',
  ticker: '<path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>',
  menu: '<path d="M4 6h16M4 12h16M4 18h10"/>',
  branding: '<circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.9 0 1.6-.7 1.6-1.7 0-.4-.2-.8-.4-1.1-.3-.3-.4-.7-.4-1.1a1.6 1.6 0 0 1 1.6-1.7h2c3 0 5.6-2.5 5.6-5.6C22 6 17.5 2 12 2Z"/>',
  settings: '<path d="M12.2 2h-.4a2 2 0 0 0-2 2v.2a2 2 0 0 1-1 1.7l-.4.3a2 2 0 0 1-2 0l-.2-.1a2 2 0 0 0-2.7.7l-.2.4a2 2 0 0 0 .7 2.7l.2.1a2 2 0 0 1 1 1.7v.5a2 2 0 0 1-1 1.7l-.2.1a2 2 0 0 0-.7 2.7l.2.4a2 2 0 0 0 2.7.7l.2-.1a2 2 0 0 1 2 0l.4.3a2 2 0 0 1 1 1.7v.2a2 2 0 0 0 2 2h.4a2 2 0 0 0 2-2v-.2a2 2 0 0 1 1-1.7l.4-.3a2 2 0 0 1 2 0l.2.1a2 2 0 0 0 2.7-.7l.2-.4a2 2 0 0 0-.7-2.7l-.2-.1a2 2 0 0 1-1-1.7v-.5a2 2 0 0 1 1-1.7l.2-.1a2 2 0 0 0 .7-2.7l-.2-.4a2 2 0 0 0-2.7-.7l-.2.1a2 2 0 0 1-2 0l-.4-.3a2 2 0 0 1-1-1.7V4a2 2 0 0 0-2-2Z"/><circle cx="12" cy="12" r="3"/>',
  external: '<path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>',
  logout: '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  moon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
  burger: '<path d="M4 6h16M4 12h16M4 18h16"/>',
};
const icon = (k: string) => `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${I[k]}</svg>`;

const groups: [string, [string, string, string][]][] = [
  ['', [['dashboard', '/admin/', 'Dashboard']]],
  ['Content', [['posts', '/admin/posts/', 'Posts'], ['pages', '/admin/pages/', 'Pages'], ['media', '/admin/media/', 'Media']]],
  ['Appearance', [['homepage', '/admin/homepage/', 'Homepage'], ['menu', '/admin/menu/', 'Menu'], ['ticker', '/admin/ticker/', 'Ticker bar'], ['branding', '/admin/branding/', 'Logo & favicon']]],
  ['System', [['settings', '/admin/settings/', 'SEO & settings']]],
];
const siteName = seo.siteTitle || 'ProPak News';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{title} · {siteName} Admin</title>
  {brand.favicon && <link rel="icon" href={brand.favicon} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  <script is:inline>
    try { const t = localStorage.getItem('ppn-admin-theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
  </script>
  <style is:global>
    :root {
      --primary: #d64000; --primary-600: #b83700; --primary-soft: #fdeee6; --secondary: #b42318;
      --bg: #f6f7f9; --card: #ffffff; --ink: #111827; --ink-2: #4b5563; --muted: #6b7280;
      --rule: #e5e7eb; --field: #ffffff; --field-rule: #d1d5db; --hover: #f3f4f6;
      --side: #0f1115; --side-ink: #a1a7b3; --side-hover: #1b1e25;
      --ok: #067647; --ok-soft: #dcfae6; --warn: #93370d; --warn-soft: #fef0c7; --bad: #b42318; --bad-soft: #fee4e2;
      --shadow: 0 1px 2px rgba(16,24,40,.05), 0 1px 3px rgba(16,24,40,.06);
      --shadow-lg: 0 20px 48px -12px rgba(16,24,40,.25);
      --r: 10px;
      color-scheme: light;
    }
    :root[data-theme="dark"] {
      --primary-soft: #3a1d10; --bg: #0b0d11; --card: #14171d; --ink: #eef0f3; --ink-2: #c3c8d0; --muted: #8b93a1;
      --rule: #262a33; --field: #0f1217; --field-rule: #313643; --hover: #1b1f27;
      --side: #07080b; --side-hover: #161920;
      --ok-soft: #0b2b1d; --ok: #6ce9a6; --warn-soft: #3b2a07; --warn: #fdb022; --bad-soft: #3d1210; --bad: #fda29b;
      --shadow: 0 1px 2px rgba(0,0,0,.4); color-scheme: dark;
    }
    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    html, body { margin: 0; }
    body { font-family: Inter, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif; font-size: 14px; background: var(--bg); color: var(--ink); -webkit-font-smoothing: antialiased; }
    a { color: var(--primary); }
    .shell { display: grid; grid-template-columns: 248px minmax(0, 1fr); min-height: 100vh; }

    /* sidebar */
    aside.nav { background: var(--side); color: var(--side-ink); position: sticky; top: 0; height: 100vh; overflow-y: auto; display: flex; flex-direction: column; padding: 14px 12px; }
    .nav .logo { display: flex; align-items: center; gap: 10px; padding: 6px 8px 18px; color: #fff; font-weight: 700; font-size: 15px; text-decoration: none; }
    .nav .logo img { max-height: 30px; max-width: 150px; object-fit: contain; }
    .nav .logo .mark { width: 30px; height: 30px; border-radius: 8px; background: var(--primary); display: grid; place-items: center; font-size: 14px; }
    .nav .grp { font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: #5d6470; padding: 16px 10px 6px; font-weight: 600; }
    .nav a.item { display: flex; align-items: center; gap: 11px; padding: 8px 10px; border-radius: 8px; color: inherit; text-decoration: none; font-weight: 500; margin: 1px 0; }
    .nav a.item:hover { background: var(--side-hover); color: #fff; }
    .nav a.item.on { background: var(--side-hover); color: #fff; box-shadow: inset 3px 0 0 var(--primary); }
    .nav a.item.on svg { color: var(--primary); }
    .nav .foot { margin-top: auto; border-top: 1px solid #1f232b; padding-top: 10px; }
    .nav .newbtn { display: flex; align-items: center; justify-content: center; gap: 8px; background: var(--primary); color: #fff; border-radius: 8px; padding: 9px; font-weight: 600; text-decoration: none; margin: 4px 0 6px; }
    .nav .newbtn:hover { background: var(--primary-600); }

    /* top bar */
    .main { min-width: 0; display: flex; flex-direction: column; }
    .topbar { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 12px; padding: 12px 28px; background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--rule); }
    .topbar h1 { margin: 0; font-size: 20px; font-weight: 700; letter-spacing: -.01em; }
    .topbar .sub { color: var(--muted); font-size: 13px; margin-top: 2px; }
    .topbar .sp { flex: 1; }
    .iconbtn { width: 36px; height: 36px; display: inline-grid; place-items: center; border-radius: 8px; border: 1px solid var(--rule); background: var(--card); color: var(--ink-2); cursor: pointer; }
    .iconbtn:hover { background: var(--hover); }
    #burger { display: none; }
    .content { padding: 24px 28px 64px; max-width: 1180px; width: 100%; }
    .content.wide { max-width: none; }

    /* primitives (class names are shared by every admin page) */
    h2, h3 { letter-spacing: -.01em; }
    .card { background: var(--card); border: 1px solid var(--rule); border-radius: var(--r); padding: 20px; margin-bottom: 18px; box-shadow: var(--shadow); }
    .card > h3:first-child, .card > h2:first-child { margin-top: 0; font-size: 15px; }
    .meta, small { color: var(--muted); font-weight: 400; }
    input[type=text], input[type=password], input[type=datetime-local], input[type=email], input[type=url], input[type=search], select, textarea {
      width: 100%; padding: 9px 12px; border: 1px solid var(--field-rule); border-radius: 8px; font: inherit; background: var(--field); color: var(--ink); transition: border-color .15s, box-shadow .15s; }
    input:focus, select:focus, textarea:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 18%, transparent); }
    textarea.code { font-family: ui-monospace, 'JetBrains Mono', Consolas, monospace; font-size: 13px; min-height: 320px; }
    label { display: block; font-weight: 600; font-size: 13px; margin: 14px 0 6px; color: var(--ink); }
    label:has(> input[type=checkbox]) { display: flex; align-items: center; gap: 8px; font-weight: 500; }
    hr { border: 0; border-top: 1px solid var(--rule); margin: 16px 0; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; background: var(--primary); color: #fff; border: 1px solid transparent; border-radius: 8px; padding: 9px 16px; font: inherit; font-weight: 600; cursor: pointer; text-decoration: none; transition: background .15s, transform .05s; white-space: nowrap; }
    .btn:hover { background: var(--primary-600); }
    .btn:active { transform: translateY(1px); }
    .btn.gray { background: var(--card); color: var(--ink); border-color: var(--field-rule); box-shadow: var(--shadow); }
    .btn.gray:hover { background: var(--hover); }
    .btn.red { background: var(--card); color: var(--bad); border-color: color-mix(in srgb, var(--bad) 35%, transparent); }
    .btn.red:hover { background: var(--bad-soft); }
    .btn.sm { padding: 5px 10px; font-size: 12.5px; border-radius: 7px; }
    .btn[disabled] { opacity: .55; pointer-events: none; }
    table { width: 100%; border-collapse: separate; border-spacing: 0; background: var(--card); border: 1px solid var(--rule); border-radius: var(--r); overflow: hidden; box-shadow: var(--shadow); }
    th { text-align: left; padding: 11px 14px; font-size: 12px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; background: var(--hover); border-bottom: 1px solid var(--rule); }
    td { padding: 12px 14px; border-bottom: 1px solid var(--rule); vertical-align: middle; }
    tbody tr:last-child td { border-bottom: 0; }
    tbody tr:hover td { background: color-mix(in srgb, var(--hover) 60%, transparent); }
    td a { color: var(--ink); font-weight: 600; text-decoration: none; }
    td a:hover { color: var(--primary); }
    td a.btn { color: #fff; }
    .card table { box-shadow: none; }
    .tabs { display: inline-flex; gap: 2px; margin-bottom: 14px; background: var(--hover); padding: 3px; border-radius: 9px; border: 1px solid var(--rule); }
    .tabs a { padding: 6px 14px; border-radius: 7px; text-decoration: none; color: var(--ink-2); font-weight: 500; font-size: 13px; }
    .tabs a.on { background: var(--card); color: var(--ink); box-shadow: var(--shadow); }
    .pill { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 600; padding: 2px 9px; border-radius: 999px; background: var(--hover); color: var(--ink-2); text-transform: capitalize; }
    .pill.published { background: var(--ok-soft); color: var(--ok); } .pill.draft { background: var(--warn-soft); color: var(--warn); } .pill.trash { background: var(--bad-soft); color: var(--bad); }
    .pill.published::before, .pill.draft::before, .pill.trash::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .toast { position: fixed; bottom: 22px; right: 22px; background: var(--ink); color: var(--card); padding: 11px 18px; border-radius: 10px; font-weight: 500; box-shadow: var(--shadow-lg); z-index: 100; opacity: 0; transform: translateY(8px); transition: .2s; pointer-events: none; }
    .toast.show { opacity: 1; transform: none; }
    .modal { position: fixed; inset: 0; background: rgba(10,12,16,.55); backdrop-filter: blur(3px); display: none; align-items: center; justify-content: center; z-index: 50; padding: 16px; }
    .modal.open { display: flex; }
    .modal .box { background: var(--card); color: var(--ink); border-radius: 14px; padding: 22px; width: min(820px, 100%); max-height: 86vh; overflow: auto; box-shadow: var(--shadow-lg); border: 1px solid var(--rule); }
    .row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 18px; }

    @media (max-width: 900px) {
      .shell { grid-template-columns: 1fr; }
      aside.nav { position: fixed; z-index: 60; width: 260px; left: 0; transform: translateX(-100%); transition: transform .2s; }
      body.nav-open aside.nav { transform: none; box-shadow: var(--shadow-lg); }
      #burger { display: inline-grid; }
      .topbar, .content { padding-left: 16px; padding-right: 16px; }
      .grid2 { grid-template-columns: 1fr; }
      table { display: block; overflow-x: auto; }
    }
  </style>
</head>
<body>
  <div class="shell">
    <aside class="nav">
      <a class="logo" href="/admin/">
        {brand.logo ? <img src={brand.logo} alt={siteName} /> : <><span class="mark">{siteName.slice(0, 1)}</span>{siteName}</>}
      </a>
      <a class="newbtn" href="/admin/posts/edit/"><Fragment set:html={icon('plus')} />New post</a>
      {groups.map(([g, items]) => <>
        {g && <div class="grp">{g}</div>}
        {items.map(([key, url, label]) => <a href={url} class={`item ${active === key ? 'on' : ''}`}><Fragment set:html={icon(key)} />{label}</a>)}
      </>)}
      <div class="foot">
        <a class="item" href="/" target="_blank"><Fragment set:html={icon('external')} />View site</a>
        <a class="item" href="#" id="logout"><Fragment set:html={icon('logout')} />Log out</a>
      </div>
    </aside>
    <div class="main">
      <header class="topbar">
        <button class="iconbtn" id="burger" aria-label="Menu"><Fragment set:html={icon('burger')} /></button>
        <div><h1>{title}</h1>{subtitle && <div class="sub">{subtitle}</div>}</div>
        <div class="sp"></div>
        <slot name="actions" />
        <button class="iconbtn" id="themeBtn" title="Toggle dark mode" aria-label="Toggle dark mode"><Fragment set:html={icon('moon')} /></button>
      </header>
      <div class={`content ${wide ? 'wide' : ''}`}>
        <slot />
      </div>
    </div>
  </div>
  <div class="toast" id="toast"></div>
  <script is:inline>
    let toastT;
    window.toast = (msg) => { const t = document.getElementById('toast'); t.textContent = msg; t.classList.add('show'); clearTimeout(toastT); toastT = setTimeout(() => t.classList.remove('show'), 2400); };
    window.api = async (url, body) => {
      const r = await fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      const j = await r.json().catch(() => ({}));
      if (!r.ok) { alert(j.error || 'Request failed'); throw new Error(j.error); }
      return j;
    };
    document.getElementById('logout').onclick = (e) => { e.preventDefault(); fetch('/api/admin/logout', { method: 'POST' }).then(() => location.href = '/admin/login'); };
    document.getElementById('burger').onclick = () => document.body.classList.toggle('nav-open');
    document.getElementById('themeBtn').onclick = () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('ppn-admin-theme', next); } catch {}
    };
  </script>
</body>
</html>
