---
import { getSetting } from '../lib/db';
interface Props { title: string; description?: string; seoHead?: string; }
const seo = getSetting('seo', {});
const { title, description = seo.metaDescription || '', seoHead = '' } = Astro.props;
const menu = getSetting('menu', []);
const ticker = getSetting('ticker', []);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {seo.gscVerification && <meta name="google-site-verification" content={seo.gscVerification} />}
    {seo.gaId && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${seo.gaId}`}></script>
    )}
    {seo.gaId && (
      <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config','${seo.gaId}');`}></script>
    )}
    {seo.adsenseClient && seo.adsenseAuto && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${seo.adsenseClient}`} crossorigin="anonymous"></script>
    )}
    <Fragment set:html={seoHead} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700&family=Inter:wght@400;500;700&display=swap" />
    <link rel="alternate" type="application/rss+xml" title={seo.siteTitle} href="/rss.xml" />
    <style is:global>
      /*
       * Typography follows tribune.com.pk (Sep 2026 stylesheet, from saved pages).
       * Two families: Inter (UI, nav, headlines, dates) and Merriweather
       * (article body text and excerpts). Key Tribune values:
       *   nav links      Inter 11px/20px 500 uppercase #666
       *   story headline Inter 700 (cards 16px, hero larger)
       *   article h1     Inter 700 2.8rem lh 1.15
       *   article body   Merriweather 17.6px lh 1.7, first para 600 #333
       *   excerpts       Merriweather 14px/21px #464444
       *   dates          Inter 11px #777
       *   section heads  Inter 18-20px 700 uppercase, 3px solid #000 underline
       */
      :root {
        --primary: #d64000; --secondary: #a00000;
        --ink: #1a1a1a; --paper: #ffffff; --muted: #666; --rule: #e4e4e4;
        --sans: 'Inter', -apple-system, 'Segoe UI', Arial, sans-serif;
        --serif: 'Merriweather', Georgia, serif;
        --fs-h1: 44.8px; --lh-h1: 51px;         /* 2.8rem — article headline size */
        --fs-h2: 32px; --lh-h2: 40px;
        --fs-h3: 24px; --lh-h3: 30px;
        --fs-h4: 22px; --lh-h4: 28px;           /* hero card headline */
        --fs-h5: 18px; --lh-h5: 24px;           /* featured card headline */
        --fs-h6: 16px; --lh-h6: 22px;           /* story card / sidebar headline (news_list h6) */
        --fs-sechead: 20px; --lh-sechead: 24px; /* section + widget headings, uppercase */
        --fs-article: 44.8px; --lh-article: 51px; /* article page h1: Inter 700 2.8rem */
        --fs-body: 17.6px; --lh-body: 30px;     /* Merriweather article paragraphs (lh 1.7) */
        --fs-byline: 18px; --lh-byline: 26px;   /* article byline (.single .entry-meta) */
        --fs-default: 16px; --lh-default: 24px; /* base UI text */
        --fs-large: 17px; --lh-large: 24px;     /* buttons */
        --fs-small: 14px; --lh-small: 20px;     /* secondary UI text, ticker, footer */
        --fs-xs: 14px; --lh-xs: 20px;           /* dates, bylines on cards — never below 14px */
        --fs-nav: 16px; --lh-nav: 22px;         /* main menu */
        --fs-share: 25px;                       /* share icon size (.ps-slist li) */
      }
      @media (max-width: 768px) {
        :root { --fs-h1: 32px; --lh-h1: 38px; --fs-article: 32px; --lh-article: 38px;
                --fs-byline: 15px; --lh-byline: 22px; --fs-share: 20px; --fs-nav: 15px; }
      }
      * { box-sizing: border-box; }
      body { margin: 0; color: var(--ink); background: var(--paper); font-family: var(--sans); font-weight: 400;
             font-size: var(--fs-default); line-height: var(--lh-default); -webkit-font-smoothing: antialiased; }
      a { color: inherit; }
      h1, h2, h3, h4, h5, h6 { font-family: var(--sans); font-weight: 700; letter-spacing: 0; margin: 0 0 0.5em; }
      h1 { font-size: var(--fs-h1); line-height: var(--lh-h1); }
      h2 { font-size: var(--fs-h2); line-height: var(--lh-h2); }
      h3 { font-size: var(--fs-h3); line-height: var(--lh-h3); }
      h4 { font-size: var(--fs-h4); line-height: var(--lh-h4); }
      h5 { font-size: var(--fs-h5); line-height: var(--lh-h5); }
      h6 { font-size: var(--fs-h6); line-height: var(--lh-h6); }
      p { margin: 0 0 1em; }
      .pageTitle { font-size: var(--fs-h2); line-height: var(--lh-h2); margin: 0 0 16px; }
      .prose { font-family: var(--serif); font-size: var(--fs-body); line-height: var(--lh-body); }
      .prose p, .prose li { font-family: var(--serif); font-size: var(--fs-body); line-height: var(--lh-body); }
      .prose h2 { font-size: var(--fs-h4); line-height: var(--lh-h4); margin: 1.2em 0 0.4em; }
      .prose h3 { font-size: var(--fs-h5); line-height: var(--lh-h5); margin: 1.2em 0 0.4em; }
      .wrap { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
      /* Reuters-style nav */
      .topnav { border-bottom: 1px solid var(--rule); }
      .topnav .wrap { display: flex; align-items: center; gap: 28px; height: 64px; }
      .brand { font-weight: 700; font-size: 24px; line-height: 32px; text-decoration: none; letter-spacing: -0.4px; white-space: nowrap; }
      .brand .dot { color: var(--primary); }
      .brand em { font-style: normal; color: var(--secondary); }
      nav.mainmenu { display: flex; gap: 22px; overflow-x: auto; }
      nav.mainmenu a { text-decoration: none; font-weight: 600; font-size: var(--fs-nav); line-height: var(--lh-nav); text-transform: uppercase; color: #333; padding: 20px 0; border-bottom: 3px solid transparent; white-space: nowrap; }
      nav.mainmenu a:hover { border-bottom-color: var(--primary); color: var(--primary); }
      /* ticker */
      .ticker { background: #101010; color: #fff; font-size: var(--fs-small); line-height: var(--lh-small); font-weight: 500; overflow: hidden; }
      .ticker .wrap { display: flex; gap: 28px; padding: 7px 16px; overflow-x: auto; scrollbar-width: none; }
      .ticker b { font-weight: 600; color: #bbb; }
      .ticker .up { color: #2ecc71; } .ticker .down { color: #ff5c5c; }
      main.wrap { padding-top: 24px; padding-bottom: 56px; }
      footer { border-top: 2px solid var(--primary); }
      footer .wrap { padding: 20px 16px; color: var(--muted); font-size: var(--fs-small); line-height: var(--lh-small); display: flex; flex-wrap: wrap; gap: 18px; justify-content: space-between; }
      footer a { text-decoration: none; margin-right: 14px; }
      .kicker { display: inline-block; text-transform: uppercase; letter-spacing: 0.3px; font-size: var(--fs-small); line-height: var(--lh-small); color: var(--primary); font-weight: 700; }
      .meta { color: #6c707c; font-size: var(--fs-xs); line-height: var(--lh-xs); }
      img { max-width: 100%; height: auto; }
      @media (max-width: 720px) { .topnav .wrap { height: auto; flex-wrap: wrap; padding: 10px 16px; } nav.mainmenu a { padding: 10px 0; } }
    </style>
  </head>
  <body>
    <div class="topnav">
      <div class="wrap">
        <a class="brand" href="/">Pro<em>Pak</em><span class="dot">.</span>News</a>
        <nav class="mainmenu">
          {menu.map((m: any) => <a href={m.url}>{m.label}</a>)}
        </nav>
      </div>
    </div>
    {ticker.length > 0 && (
      <div class="ticker"><div class="wrap">
        {ticker.map((t: any) => (
          <span><b>{t.label}</b> {t.value} <span class={t.dir === 'down' ? 'down' : 'up'}>{t.change}</span></span>
        ))}
      </div></div>
    )}
    <main class="wrap"><slot /></main>
    <footer><div class="wrap">
      <span>© {new Date().getFullYear()} propaknews.com</span>
      <span>
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms-of-service/">Terms</a>
        <a href="/about-us/">About</a>
        <a href="/contact-us/">Contact</a>
      </span>
    </div></footer>
  </body>
</html>
