---
import { getPost, db } from '../lib/db';
interface Props { type: 'post' | 'page' }
const { type } = Astro.props;
const id = Number(Astro.url.searchParams.get('id') || 0);
const post = id ? getPost(id) : null;
const seo = post?.seo || {};
const dtLocal = post ? post.published_at.replace(' ', 'T').slice(0, 16) : '';
const defaultCats = ['Business', 'Tech and Telecom', 'Education', 'Sports', 'General'];
const cats = [...new Set([...defaultCats, ...(db.prepare("SELECT DISTINCT category c FROM posts WHERE type='post'").all() as any[]).map((r) => r.c)])];
---
<div class="ed" id="editor" data-id={post?.id || ''} data-type={type}>
  <div class="ed-main">
    <div class="card ed-doc">
      <input type="text" id="f_title" class="ed-title" value={post?.title || ''} placeholder={type === 'page' ? 'Page title' : 'Add headline'} autocomplete="off" />
      <div class="ed-slug"><span class="meta">propaknews.com{type === 'page' ? '/' : '/news/'}</span><input type="text" id="f_slug" value={post?.slug || ''} placeholder="auto-from-title" /><span class="meta">/</span></div>
      <textarea id="f_excerpt" class="ed-excerpt" rows="2" placeholder="Standfirst — one or two sentences under the headline (aim for 15–20 words)">{post?.excerpt || ''}</textarea>
      <div id="excerptCount" class="meta ed-count"></div>

      <div class="rte-wrap">
        <div class="rte-bar" id="rteBar"></div>
        <div class="rte-notice" id="rteNotice" hidden></div>
        <div id="rte"></div>
        <textarea class="code rte-src" id="f_body" spellcheck="false">{post?.body || ''}</textarea>
        <div class="rte-foot"><span id="rteStatus" class="meta"></span><span class="meta">Tip: Ctrl+K adds a link · paste from Google Docs keeps formatting</span></div>
      </div>
      <button class="btn sm gray" id="insertImg" type="button" hidden>Insert image</button>
    </div>

    <details class="card ed-seo" open={!!(seo.metaTitle || seo.metaDesc || (seo.keywords || []).length)}>
      <summary><h3>SEO &amp; social sharing</h3><span class="meta">Search preview, keywords, Open Graph</span></summary>
      <div class="serp" id="serp">
        <div class="serp-url" id="serpUrl"></div>
        <div class="serp-title" id="serpTitle"></div>
        <div class="serp-desc" id="serpDesc"></div>
      </div>
      <div class="grid2">
        <div><label>Meta title <small>(empty = headline)</small></label><input type="text" id="s_metaTitle" value={seo.metaTitle || ''} /></div>
        <div><label>Author <small>(byline)</small></label><input type="text" id="s_author" value={seo.author || ''} placeholder="News Desk" /></div>
      </div>
      <label>Meta description <small>(empty = standfirst)</small></label>
      <textarea id="s_metaDesc" rows="2">{seo.metaDesc || ''}</textarea>
      <label>Focus keywords</label>
      <div id="kwPreview" class="kw-preview"><span class="meta">Click to add / view all keywords…</span></div>
      <div class="grid2">
        <div><label>Canonical URL <small>(empty = this page)</small></label><input type="text" id="s_canonical" value={seo.canonical || ''} /></div>
        <div><label>Twitter card</label>
          <select id="s_twitterCard">
            <option value="summary_large_image" selected={!seo.twitterCard || seo.twitterCard === 'summary_large_image'}>Large image</option>
            <option value="summary" selected={seo.twitterCard === 'summary'}>Small summary</option>
          </select></div>
      </div>
      <label><input type="checkbox" id="s_noindex" checked={!!seo.noindex} /> Hide from Google (noindex)</label>
      <hr />
      <div class="grid2">
        <div><label>Social title <small>(empty = meta title)</small></label><input type="text" id="s_ogTitle" value={seo.ogTitle || ''} /></div>
        <div><label>Social image <small>(empty = featured)</small></label>
          <div class="row" style="flex-wrap:nowrap;"><input type="text" id="s_ogImage" value={seo.ogImage || ''} /><button class="btn sm gray" type="button" id="pickOg">Pick</button></div></div>
      </div>
      <label>Social description</label>
      <textarea id="s_ogDesc" rows="2">{seo.ogDesc || ''}</textarea>
    </details>
  </div>

  <aside class="ed-side">
    <div class="card">
      <h3>Publish</h3>
      <label>Status</label>
      <select id="f_status">
        <option value="draft" selected={!post || post.status === 'draft'}>Draft</option>
        <option value="published" selected={post?.status === 'published'}>Published</option>
      </select>
      <label>Publish date <small>(orders Latest News)</small></label>
      <input type="datetime-local" id="f_published_at" value={dtLocal} />
      <div class="row" style="margin-top:16px;">
        <button class="btn" id="saveBtn" style="flex:1;">Save</button>
      </div>
      <p class="meta ed-saved" id="viewLink">{post ? `Last updated ${post.updated_at} UTC` : 'Not saved yet'}</p>
      <p class="meta" style="margin:0;font-size:12px;">Ctrl+S saves</p>
    </div>

    {type === 'post' && (
      <div class="card">
        <h3>Category</h3>
        <input type="text" id="f_category" value={post?.category || 'General'} list="cats" />
        <datalist id="cats">{cats.map((c) => <option>{c}</option>)}</datalist>
      </div>
    )}

    <div class="card">
      <h3>Featured image</h3>
      <div class="feat" id="featBox">
        <img id="featPreview" src={post?.featured_image || ''} alt="" style={post?.featured_image ? '' : 'display:none;'} />
        <button class="feat-empty" type="button" id="pickFeat" style={post?.featured_image ? 'display:none;' : ''}>+ Set featured image</button>
      </div>
      <input type="hidden" id="f_featured_image" value={post?.featured_image || ''} />
      <div class="row" style="margin-top:8px;">
        <button class="btn sm gray" type="button" id="changeFeat">Replace</button>
        <button class="btn sm red" type="button" id="clearFeat">Remove</button>
      </div>
    </div>
  </aside>
</div>

<!-- keywords modal -->
<div class="modal" id="kwModal"><div class="box">
  <h3 style="margin-top:0;">Focus keywords</h3>
  <p class="meta">Type a keyword and press Enter. Paste many separated by commas.</p>
  <input type="text" id="kwInput" placeholder="add keyword, or paste: keyword one, keyword two, …" />
  <div id="kwList" style="display:flex;flex-wrap:wrap;gap:6px;margin:12px 0;max-height:40vh;overflow:auto;"></div>
  <button class="btn" onclick="document.getElementById('kwModal').classList.remove('open')">Done</button>
</div></div>

<!-- media picker modal -->
<div class="modal" id="mediaModal"><div class="box">
  <div class="row" style="justify-content:space-between;margin-bottom:12px;">
    <h3 style="margin:0;">Media library</h3>
    <button class="btn sm gray" type="button" onclick="document.getElementById('mediaModal').classList.remove('open')">Close</button>
  </div>
  <label class="drop" for="mUp">⬆ Upload images <span class="meta">— or drag them here · converted to webp automatically</span>
    <input type="file" id="mUp" multiple accept="image/*" hidden /></label>
  <div id="mGrid" class="mgrid"></div>
</div></div>

<style is:global>
  .ed { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 20px; align-items: start; }
  .ed-side { position: sticky; top: 84px; }
  .ed-side h3, .ed-seo h3 { margin: 0 0 4px; font-size: 14px; }
  .ed-doc { padding: 28px 32px; }
  .ed-title { border: 0 !important; box-shadow: none !important; padding: 0 !important; font-size: 30px !important; font-weight: 700; letter-spacing: -.02em; background: transparent !important; }
  .ed-slug { min-width: 0; display: flex; align-items: center; gap: 2px; margin: 8px 0 14px; font-size: 13px; }
  .ed-slug input { border: 0 !important; border-bottom: 1px dashed var(--field-rule) !important; border-radius: 0 !important; padding: 2px 4px !important; width: auto !important; flex: 1; min-width: 0; max-width: 420px; background: transparent !important; box-shadow: none !important; color: var(--ink-2) !important; }
  .ed-excerpt { border: 0 !important; border-left: 3px solid var(--primary) !important; border-radius: 0 !important; font-size: 16px !important; color: var(--ink-2) !important; resize: vertical; background: transparent !important; box-shadow: none !important; }
  .ed-count { font-size: 12px; margin: 4px 0 18px; }
  .ed-saved { margin: 10px 0 2px; text-align: center; }

  .rte-wrap { border: 1px solid var(--field-rule); border-radius: 10px; background: var(--field); }
  .rte-wrap:focus-within { border-color: var(--primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 15%, transparent); }
  .rte-bar { position: sticky; top: 61px; z-index: 5; display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: center; padding: 6px; background: var(--card); border-bottom: 1px solid var(--rule); border-radius: 10px 10px 0 0; }
  .tb-group { display: flex; flex-wrap: wrap; gap: 2px; align-items: center; }
  .tb-right { margin-left: auto; }
  .tb { min-width: 32px; height: 32px; padding: 0 8px; border: 0; border-radius: 6px; background: transparent; color: var(--ink); font: inherit; font-size: 13.5px; cursor: pointer; }
  .tb:hover { background: var(--hover); }
  .tb.on { background: var(--primary-soft); color: var(--primary); }
  .tb:disabled { opacity: .35; cursor: default; }
  .tb mark { background: #fde68a; padding: 0 2px; }
  .tb-sep { width: 1px; height: 20px; background: var(--rule); margin: 0 4px; }
  .tb-table { padding-left: 8px; border-left: 1px solid var(--rule); }
  .tb-mode { border: 1px solid var(--field-rule); font-family: ui-monospace, monospace; font-size: 12px; }
  .rte-notice { padding: 8px 14px; background: var(--warn-soft); color: var(--warn); font-size: 13px; }
  .rte-src { border: 0 !important; border-radius: 0 !important; box-shadow: none !important; min-height: 520px !important; display: block; }
  .rte-src[hidden] { display: none; }
  .rte-foot { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; padding: 8px 14px; border-top: 1px solid var(--rule); font-size: 12px; }

  /* the writing surface: close to how the article renders */
  #rte .prose { min-height: 520px; padding: 22px 26px; outline: none; font-family: Merriweather, Georgia, serif; font-size: 17px; line-height: 1.75; color: var(--ink); }
  #rte .prose > :first-child { margin-top: 0; }
  #rte .prose p { margin: 0 0 1em; }
  #rte .prose h2, #rte .prose h3, #rte .prose h4 { font-family: Inter, sans-serif; line-height: 1.25; margin: 1.4em 0 .4em; }
  #rte .prose h2 { font-size: 1.5em; } #rte .prose h3 { font-size: 1.25em; } #rte .prose h4 { font-size: 1.08em; }
  #rte .prose a { color: var(--primary); text-decoration: underline; }
  #rte .prose blockquote { border-left: 3px solid var(--primary); margin-left: 0; padding-left: 16px; color: var(--ink-2); font-style: italic; }
  #rte .prose img { max-width: 100%; height: auto; border-radius: 6px; display: block; }
  #rte .prose img.ProseMirror-selectednode { outline: 3px solid var(--primary); }
  #rte .prose pre { background: #0f1115; color: #e5e7eb; padding: 14px; border-radius: 8px; font-size: 13px; overflow-x: auto; }
  #rte .prose code { font-family: ui-monospace, monospace; font-size: .88em; }
  #rte .prose mark { background: #fde68a; color: inherit; }
  #rte .prose hr { border: 0; border-top: 2px solid var(--rule); margin: 1.6em 0; }
  #rte .prose table { border-collapse: collapse; width: 100%; box-shadow: none; border-radius: 0; font-family: Inter, sans-serif; font-size: 14px; }
  #rte .prose th, #rte .prose td { border: 1px solid var(--rule); padding: 8px 10px; text-transform: none; letter-spacing: 0; font-size: 14px; position: relative; }
  #rte .prose .selectedCell { background: var(--primary-soft); }
  #rte .prose iframe { width: 100%; aspect-ratio: 16/9; height: auto; border: 0; border-radius: 8px; }
  #rte .prose p.is-editor-empty:first-child::before { content: attr(data-placeholder); color: var(--muted); float: left; height: 0; pointer-events: none; }

  .ed-seo summary { list-style: none; cursor: pointer; display: flex; align-items: baseline; gap: 12px; }
  .ed-seo summary::-webkit-details-marker { display: none; }
  .ed-seo summary::after { content: '▾'; margin-left: auto; color: var(--muted); }
  .ed-seo[open] summary { margin-bottom: 14px; }
  .serp { border: 1px solid var(--rule); border-radius: 10px; padding: 14px 16px; background: var(--hover); font-family: Arial, sans-serif; }
  .serp-url { font-size: 12px; color: var(--ink-2); }
  .serp-title { font-size: 19px; color: #1a0dab; margin: 3px 0; line-height: 1.3; }
  :root[data-theme="dark"] .serp-title { color: #99c3ff; }
  .serp-desc { font-size: 13.5px; color: var(--ink-2); line-height: 1.5; }
  .kw-preview { border: 1px solid var(--field-rule); border-radius: 8px; padding: 8px 10px; min-height: 40px; cursor: pointer; background: var(--field); display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }

  .feat { border-radius: 8px; overflow: hidden; }
  .feat img { width: 100%; display: block; aspect-ratio: 16/9; object-fit: cover; cursor: pointer; }
  .feat-empty { width: 100%; aspect-ratio: 16/9; border: 2px dashed var(--field-rule); border-radius: 8px; background: var(--hover); color: var(--ink-2); font: inherit; font-weight: 600; cursor: pointer; }
  .feat-empty:hover { border-color: var(--primary); color: var(--primary); }

  .drop { display: block; border: 2px dashed var(--field-rule); border-radius: 10px; padding: 18px; text-align: center; cursor: pointer; margin: 0 0 14px; }
  .drop:hover, .drop.over { border-color: var(--primary); background: var(--primary-soft); }
  .mgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 10px; }
  .mgrid img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; cursor: pointer; border: 2px solid transparent; transition: border-color .15s, transform .15s; }
  .mgrid img:hover { border-color: var(--primary); transform: scale(1.02); }

  @media (max-width: 1100px) { .ed { grid-template-columns: minmax(0, 1fr); } .ed-side { position: static; } }
  @media (max-width: 600px) { .ed-doc { padding: 18px 14px; } .ed-title { font-size: 24px !important; } #rte .prose { padding: 16px; } }
</style>

<script is:inline define:vars={{ initialKeywords: seo.keywords || [] }}>
  window.__keywords = initialKeywords;
</script>
<script is:inline src="/admin-editor.js"></script>
<script>
  import '../scripts/rich-editor.ts';
</script>
