---
import Base from '../../layouts/Base.astro';
import { getPostBySlug, publishedPosts, getSetting } from '../../lib/db';

const { slug } = Astro.params;
const post = slug ? getPostBySlug(slug) : null;
if (!post) return new Response(null, { status: 404, statusText: 'Not found' });
const seoSite = getSetting('seo', {});
const s = post.seo || {};
// Sidebar: "Latest News" (title left / thumb right) then "Now Trending" (image above title)
const sidebarPosts = publishedPosts(9, 0, [post.id]);
const latestNews = sidebarPosts.slice(0, 5);
const trending = sidebarPosts.slice(5, 9);
const canonicalUrl = s.canonical || new URL(`/news/${post.slug}/`, Astro.site).href;
const ogImage = s.ogImage || post.featured_image;
const iso = (d: string) => new Date(d.replace(' ', 'T') + 'Z').toISOString();
const seoHead = `
${s.noindex ? '<meta name="robots" content="noindex,nofollow">' : ''}
${(s.keywords?.length) ? `<meta name="keywords" content="${s.keywords.join(', ').replace(/"/g, '&quot;')}">` : ''}
<meta property="og:type" content="article">
<meta property="og:title" content="${(s.ogTitle || s.metaTitle || post.title).replace(/"/g, '&quot;')}">
<meta property="og:description" content="${(s.ogDesc || s.metaDesc || post.excerpt).replace(/"/g, '&quot;')}">
<meta property="og:url" content="${canonicalUrl}">
${ogImage ? `<meta property="og:image" content="${new URL(ogImage, Astro.site).href}">` : ''}
<meta property="og:site_name" content="${seoSite.siteTitle || 'ProPak News'}">
<meta name="twitter:card" content="${s.twitterCard || 'summary_large_image'}">
<meta name="twitter:title" content="${(s.ogTitle || post.title).replace(/"/g, '&quot;')}">
<meta name="twitter:description" content="${(s.ogDesc || post.excerpt).replace(/"/g, '&quot;')}">
${ogImage ? `<meta name="twitter:image" content="${new URL(ogImage, Astro.site).href}">` : ''}
<script type="application/ld+json">${JSON.stringify({
  '@context': 'https://schema.org', '@type': 'NewsArticle',
  headline: post.title, description: post.excerpt,
  image: ogImage ? [new URL(ogImage, Astro.site).href] : [],
  datePublished: iso(post.published_at), dateModified: iso(post.updated_at),
  articleSection: post.category, keywords: (s.keywords || []).join(', '),
  mainEntityOfPage: canonicalUrl,
  publisher: { '@type': 'Organization', name: seoSite.siteTitle || 'ProPak News' },
})}</script>`;
const asDate = (d: string) => new Date(d.replace(' ', 'T') + 'Z');
const fmtDate = (d: string) => asDate(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const fmtTime = (d: string) => asDate(d).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
const author = s.author || 'News Desk';
const shareUrl = encodeURIComponent(canonicalUrl);
const shareText = encodeURIComponent(post.title);
const shares = [
  { name: 'Facebook', cls: 'facebook', href: `https://www.facebook.com/sharer.php?u=${shareUrl}`,
    path: 'M9.1 21.5v-7.4H6.6v-3h2.5V9c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6v1.8h2.8l-.4 3h-2.4v7.4a10 10 0 1 0-3.1 0z' },
  { name: 'X (Twitter)', cls: 'twitter', href: `https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`,
    path: 'M17.5 3h3.1l-6.8 7.7L21.8 21h-6.2l-4.9-6.3L5.1 21H2l7.2-8.3L2.2 3h6.4l4.4 5.8L17.5 3zm-1.1 16.1h1.7L7.7 4.8H5.9l10.5 14.3z' },
  { name: 'WhatsApp', cls: 'whatsapp', href: `https://api.whatsapp.com/send?text=${shareText}%20${shareUrl}`,
    path: 'M12 2a9.9 9.9 0 0 0-8.5 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.1-.2 0-.4.1-.5l.4-.5c.1-.2.2-.3.2-.5s0-.4-.1-.5l-.7-1.7c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9 1.6.7 2.2.7 3 .6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.5-.2z' },
  { name: 'LinkedIn', cls: 'linkedin', href: `https://www.linkedin.com/shareArticle?mini=true&url=${shareUrl}&title=${shareText}`,
    path: 'M20.4 3H3.6c-.9 0-1.6.7-1.6 1.6v16.8c0 .9.7 1.6 1.6 1.6h16.8c.9 0 1.6-.7 1.6-1.6V4.6c0-.9-.7-1.6-1.6-1.6zM8.3 18.8H5.4V9.9h2.9v8.9zM6.9 8.7a1.7 1.7 0 1 1 0-3.4 1.7 1.7 0 0 1 0 3.4zm11.9 10.1H16v-4.3c0-1 0-2.4-1.5-2.4s-1.7 1.1-1.7 2.3v4.4h-2.9V9.9h2.8v1.2h.1c.4-.7 1.3-1.5 2.7-1.5 2.9 0 3.4 1.9 3.4 4.4v4.8z' },
];
---
<Base title={s.metaTitle || `${post.title} — ${seoSite.siteTitle || 'ProPak News'}`}
      description={s.metaDesc || post.excerpt} seoHead={seoHead}>
  <style>
    .layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 40px; }
    article h1 { font-size: var(--fs-article); line-height: var(--lh-article); font-weight: 700; color: #000; margin: 8px 0 12px; }

    /* Byline row: author | published date | time, with share icons on the right */
    .entryMeta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between;
      color: #000; font-size: var(--fs-byline); line-height: var(--lh-byline); font-weight: 400; margin: 15px 0 20px; }
    .entryMeta .by a, .entryMeta .by b { color: var(--primary); font-weight: 600; }
    .entryMeta .sep { color: #c7c7c7; margin: 0 8px; }
    .shareList { display: flex; align-items: center; gap: 14px; list-style: none; margin: 0; padding: 0; }
    .shareList a { display: inline-flex; color: #6c707c; transition: color 0.15s; }
    .shareList svg { width: var(--fs-share); height: var(--fs-share); fill: currentColor; display: block; }
    .shareList .facebook a:hover { color: #1877f2; }
    .shareList .twitter a:hover  { color: #000; }
    .shareList .whatsapp a:hover { color: #25d366; }
    .shareList .linkedin a:hover { color: #0a66c2; }

    .body { font-family: var(--serif); font-size: var(--fs-body); line-height: var(--lh-body); margin-top: 16px; }
    .body :global(p), .body :global(li) { font-family: var(--serif); font-size: var(--fs-body); line-height: var(--lh-body); }
    .body :global(p) { padding-bottom: 20px; margin: 0; }
    .body :global(p:first-of-type) { font-weight: 600; color: #333; }
    .body :global(h2) { font-size: var(--fs-h4); line-height: var(--lh-h4); margin: 1.2em 0 0.4em; }
    .body :global(h3) { font-size: var(--fs-h5); line-height: var(--lh-h5); margin: 1.2em 0 0.4em; }
    .featimg { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: 4px; margin: 14px 0; }

    /* Sidebar widgets (propakistani .widget / .news_list) */
    aside { font-family: var(--sans); }
    .widget { margin-bottom: 30px; }
    .widgetTitle { background: #001839; color: #fff; font-weight: 700; font-size: var(--fs-sechead);
      line-height: var(--lh-sechead); padding: 10px 15px; margin: 0 0 15px; }
    .newsList { list-style: none; padding: 0; margin: 0; }
    .newsList h6 { font-size: var(--fs-h6); line-height: var(--lh-h6); font-weight: 600; margin: 0; color: #111; }
    .newsList a { text-decoration: none; display: block; }
    .newsList a:hover h6 { color: var(--primary); }
    /* mini = title left, thumbnail right */
    .newsList.mini li { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 20px; }
    .newsList.mini .sideText { flex: 1; min-width: 0; }
    .newsList.mini .sideImg { width: 100px; flex-shrink: 0; }
    .newsList.mini .sideImg img { width: 100px; height: 62px; object-fit: cover; border-radius: 3px; display: block; }
    /* stacked = image above, title under it */
    .newsList.stacked li { margin-bottom: 22px; }
    .newsList.stacked img { width: 100%; aspect-ratio: 395/235; object-fit: cover; border-radius: 3px; display: block; }
    .newsList.stacked h6 { margin: 10px 0 0; }

    @media (max-width: 900px) {
      .layout { grid-template-columns: 1fr; }
      aside { border: 0; padding: 0; }
    }
  </style>
  <div class="layout">
    <article>
      <span class="kicker">{post.category}</span>
      <h1>{post.title}</h1>

      <div class="entryMeta">
        <div class="by">
          By <b>{author}</b>
          <span class="sep">|</span>Published {fmtDate(post.published_at)}
          <span class="sep">|</span>{fmtTime(post.published_at)}
        </div>
        <ul class="shareList">
          {shares.map((sh) => (
            <li class={sh.cls}>
              <a href={sh.href} target="_blank" rel="noopener noreferrer"
                 aria-label={`Share on ${sh.name}`} title={`Share on ${sh.name}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={sh.path} /></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      {post.featured_image && <img class="featimg" src={post.featured_image} alt={post.title} fetchpriority="high" />}
      <div class="body" set:html={post.body} />
    </article>

    <aside>
      <div class="widget">
        <h2 class="widgetTitle">Latest News</h2>
        <ul class="newsList mini">
          {latestNews.map((p) => (
            <li>
              <div class="sideText">
                <a href={`/news/${p.slug}/`}><h6>{p.title}</h6></a>
              </div>
              <div class="sideImg">
                <a href={`/news/${p.slug}/`}><img src={p.featured_image} alt="" loading="lazy" /></a>
              </div>
            </li>
          ))}
        </ul>
      </div>

      {trending.length > 0 && (
        <div class="widget">
          <h2 class="widgetTitle">Now Trending</h2>
          <ul class="newsList stacked">
            {trending.map((p) => (
              <li>
                <a href={`/news/${p.slug}/`}>
                  <img src={p.featured_image} alt="" loading="lazy" />
                  <h6>{p.title}</h6>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>
</Base>
