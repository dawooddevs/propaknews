---
import { getSetting } from '../../lib/db';
const brand = getSetting('branding', {});
const siteName = getSetting('seo', {}).siteTitle || 'ProPak News';
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" /><title>Log in · {siteName}</title>
{brand.favicon && <link rel="icon" href={brand.favicon} />}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
<style>
  * { box-sizing: border-box; }
  body { font-family: Inter, -apple-system, 'Segoe UI', Arial, sans-serif; margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 16px;
    background: radial-gradient(1200px 600px at 10% -10%, #3a1a0a 0%, transparent 60%), radial-gradient(900px 500px at 110% 110%, #2a0c0c 0%, transparent 55%), #0b0d11; color: #111827; }
  form { background: #fff; padding: 36px 32px 30px; border-radius: 16px; width: min(380px, 100%); box-shadow: 0 30px 60px -20px rgba(0,0,0,.6); }
  .logo { display: flex; align-items: center; gap: 10px; margin-bottom: 22px; font-weight: 700; font-size: 17px; }
  .logo img { max-height: 36px; max-width: 200px; }
  .logo .mark { width: 34px; height: 34px; border-radius: 9px; background: #d64000; color: #fff; display: grid; place-items: center; }
  h1 { font-size: 22px; margin: 0 0 4px; letter-spacing: -.02em; }
  p.sub { color: #6b7280; margin: 0 0 20px; font-size: 14px; }
  label { display: block; font-size: 13px; font-weight: 600; margin: 12px 0 6px; }
  input { width: 100%; padding: 11px 12px; border: 1px solid #d1d5db; border-radius: 9px; font: inherit; transition: border-color .15s, box-shadow .15s; }
  input:focus { outline: none; border-color: #d64000; box-shadow: 0 0 0 3px rgba(214,64,0,.16); }
  button { width: 100%; padding: 12px; background: #d64000; border: 0; border-radius: 9px; color: #fff; font: inherit; font-weight: 600; font-size: 15px; cursor: pointer; margin-top: 20px; transition: background .15s; }
  button:hover { background: #b83700; } button:disabled { opacity: .6; }
  .err { color: #b42318; background: #fee4e2; font-size: 13px; padding: 9px 12px; border-radius: 8px; margin: 0 0 8px; }
  .err:empty { display: none; }
</style></head>
<body>
  <form id="f">
    <div class="logo">{brand.logo ? <img src={brand.logo} alt={siteName} /> : <><span class="mark">{siteName.slice(0, 1)}</span>{siteName}</>}</div>
    <h1>Welcome back</h1>
    <p class="sub">Log in to manage your site.</p>
    <p class="err" id="err"></p>
    <label for="u">Username</label>
    <input name="username" id="u" autocomplete="username" required autofocus />
    <label for="p">Password</label>
    <input name="password" id="p" type="password" autocomplete="current-password" required />
    <button id="go">Log in</button>
  </form>
  <script>
    document.getElementById('f')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const go = document.getElementById('go') as HTMLButtonElement;
      go.disabled = true; go.textContent = 'Logging in…';
      const r = await fetch('/api/admin/login', { method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ username: (document.getElementById('u') as HTMLInputElement).value,
                               password: (document.getElementById('p') as HTMLInputElement).value }) });
      if (r.ok) { location.href = '/admin/'; return; }
      document.getElementById('err')!.textContent = (await r.json().catch(() => ({}))).error || 'Login failed';
      go.disabled = false; go.textContent = 'Log in';
    });
  </script>
</body></html>
