---
import Base from '../../layouts/Base.astro';
import { db } from '../../lib/db';
const { cat } = Astro.params;
const posts = db.prepare(
  `SELECT * FROM posts WHERE type='post' AND status='published'
   AND lower(replace(category, ' ', '-')) = ? ORDER BY published_at DESC LIMIT 40`,
).all((cat || '').toLowerCase()) as any[];
const name = posts[0]?.category || (cat || '').replace(/-/g, ' ');
---
<Base title={`${name} — ProPak News`}>
  <h1 class="pageTitle" style="text-transform: capitalize;">{name}</h1>
  {posts.length === 0 && <p>No articles in this category yet.</p>}
  {posts.map((p) => (
    <article style="border-bottom: 1px solid var(--rule); padding: 14px 0;">
      <a href={`/news/${p.slug}/`} style="text-decoration: none;"><h3 style="margin: 0 0 4px; font-size: var(--fs-h5); line-height: var(--lh-h5);">{p.title}</h3></a>
      <p style="margin: 0; font-family: var(--serif); font-size: var(--fs-default); line-height: 24px; color: #464444;">{p.excerpt}</p>
    </article>
  ))}
</Base>
